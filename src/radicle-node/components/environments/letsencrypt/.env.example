# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
P2P_VIRTUAL_PORT=8776
P2P_VIRTUAL_HOST=p2p.radicle-example.com

API_VIRTUAL_PORT=8080
API_VIRTUAL_HOST=api.radicle-example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=p2p.radicle-example.com,api.radicle-example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com