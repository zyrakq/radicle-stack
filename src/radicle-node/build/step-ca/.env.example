# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=radicle-node

# Docker image
IMAGE=localhost/radicle-node

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RAD_HOME=/home/seed/.radicle

RUST_LOG=info
RUST_BACKTRACE=1

RADICLE_ALIAS=seed.radicle.example
RADICLE_LISTEN=0.0.0.0:8776
RADICLE_EXTERNAL_ADDRESSES='["seed.radicle.example:8776"]'
RADICLE_SEEDING_POLICY_DEFAULT=block
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
P2P_VIRTUAL_PORT=8776
P2P_VIRTUAL_HOST=p2p.radicle.local

API_VIRTUAL_PORT=8080
API_VIRTUAL_HOST=api.radicle.local

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=p2p.radicle.local,api.radicle.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com