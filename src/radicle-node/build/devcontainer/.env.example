# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=radicle-node

# Docker image
IMAGE=localhost/radicle-node

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RAD_HOME=/home/seed/.radicle

RUST_LOG=info
RUST_BACKTRACE=1

RADICLE_ALIAS=seed.radicle.example
RADICLE_LISTEN=0.0.0.0:8776
RADICLE_EXTERNAL_ADDRESSES='["seed.radicle.example:8776"]'
RADICLE_SEEDING_POLICY_DEFAULT=block