# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=radicle-explorer

# Docker image
IMAGE=localhost/radicle-explorer

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RAD_HOME=/home/seed/.radicle

RUST_LOG=info
RUST_BACKTRACE=1

RAD_API_VERSION=~0.18.0
RAD_API_PORT=8080
RAD_API_HOST=localhost
RAD_API_SCHEME=http
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy

VIRTUAL_PORT=8080
VIRTUAL_HOST=radicle-example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=radicle-example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com