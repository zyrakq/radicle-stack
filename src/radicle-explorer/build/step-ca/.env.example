# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=radicle-explorer

# Docker image
IMAGE=localhost/radicle-explorer

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RAD_HOME=/home/seed/.radicle

RUST_LOG=info
RUST_BACKTRACE=1

RAD_API_VERSION=~0.18.0
RAD_API_PORT=8080
RAD_API_HOST=localhost
RAD_API_SCHEME=http
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=80
VIRTUAL_HOST=radicle.local

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=radicle.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com